{
  "name": "mechanic",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "backup": "tar --exclude='./node_modules' --exclude='./server/node_modules' --exclude='./admin-portal/node_modules' --exclude='./video-bot/node_modules' --exclude='./ios' --exclude='./android' --exclude='./admin-portal/.next' --exclude='./admin-portal/out' --exclude='./admin-portal/dist' --exclude='./.git' --exclude='./.expo' --exclude='./.claude' --exclude='./.DS_Store' --exclude='./assets' -czf \"$HOME/Downloads/Mechanic_backup_$(date +%Y-%m-%d_%H-%M-%S).tar.gz\" .",
    "upload": "bash ./scripts/upload.sh",
    "upload-railway": "bash ./scripts/upload-railway.sh",
    "upload_all": "UPLOAD_ALL=true bash ./scripts/upload.sh",
    "vpn": "echo '🔌 Opening SSH tunnel to Azure Minikube K8s API (localhost:8443 → remote:32776)...' && echo '   Press Ctrl+C to disconnect.' && ssh -N -L 8443:127.0.0.1:32776 usuarioifx1@20.124.131.193",
    "local": "bash ./scripts/local-deploy.sh",
    "testflight": "eas build --platform ios --profile production --non-interactive && eas submit --platform ios --profile production --latest",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:prod": "npx playwright test --config playwright.prod.config.ts",
    "test:e2e:prod:headed": "npx playwright test --config playwright.prod.config.ts --headed",
    "test:e2e:prod:report": "npx playwright show-report e2e-prod/report",
    "test:e2e:report": "npx playwright show-report e2e/report",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@daily-co/.*))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
