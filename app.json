{
  "expo": {
    "name": "Mechanic Assistance",
    "slug": "mechanic-assistance",
    "owner": "elpixel",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/mechanic-icon.png",
    "scheme": "mechanic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mechanicassistance.app",
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.mechanicassistance.app"
            ]
          }
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "googleServicesFile": "./firebase/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/mechanic-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mechanicassistance.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mechanic-icon.png",
      "bundler": "metro",
      "display": "standalone",
      "backgroundColor": "#1E56E3",
      "themeColor": "#0047AB",
      "description": "Professional Mechanic Assistance App",
      "orientation": "portrait",
      "startUrl": "/",
      "meta": {
        "apple-mobile-web-app-capable": "yes",
        "apple-mobile-web-app-status-bar-style": "black-translucent"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to find assistance near you and to show the client where you are while you head to them.",
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location in the background so the client can follow you on the map while you drive to the assistance, even with the app closed or the phone locked.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location in the background so the client can follow you on the map while you drive to the assistance.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for video calls, to verify your identity by scanning your ID document, to scan the customer's check-in QR code and the vehicle's VIN barcode when you arrive, and to take photos of the vehicle."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for video calls, to verify your identity by scanning your ID document, to scan the customer's check-in QR code and the vehicle's VIN barcode when you arrive, and to take photos of the vehicle.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for video calls and to record a short video of the vehicle's problem."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          },
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-dontwarn com.stripe.android.pushProvisioning.**"
          }
        }
      ],
      "./plugins/withFirebasePodfile",
      "./plugins/withFirebaseAuthAPNS",
      "./plugins/withAndroidNotificationChannel",
      "./plugins/withCameraIntentQueries",
      "./plugins/withStripeNoTapAndPay",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-bg.png",
          "imageWidth": 1000,
          "resizeMode": "cover",
          "backgroundColor": "#1840A8"
        }
      ],
      [
        "@didit-protocol/sdk-react-native",
        {
          "iosNfcEnabled": false,
          "androidNfcEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0c61658-b62c-4483-9314-1a3d32f9b688"
      }
    }
  }
}
